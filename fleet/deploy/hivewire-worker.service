[Unit]
Description=Hivewire HWP/1 Worker (experimental)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hivewire-worker
Group=hivewire-worker
WorkingDirectory=/opt/hivewire
ExecStart=/usr/bin/python3 -m fleet.service /etc/hivewire/worker.json --interval 15
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hivewire /srv/hivewire-worktrees
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=8192
MemoryMax=4G
TasksMax=256

[Install]
WantedBy=multi-user.target
