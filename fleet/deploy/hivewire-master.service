[Unit]
Description=Hivewire HWP/1 Master (experimental)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hivewire
Group=hivewire
WorkingDirectory=/opt/hivewire
ExecStart=/usr/bin/python3 -m fleet serve /etc/hivewire/master.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hivewire
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
